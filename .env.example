# ===================================================
# CONFIGURAÇÕES DO BOT WHATSAPP - CHB IMPORT (RENDER + NEON + BAILEYS)
# ===================================================

# 1. Servidor Web (Render)
PORT=3000

# 2. Banco de Dados PostgreSQL (Neon.tech via Prisma)
# Fornecido automaticamente pelo Neon ou gerado no console do Neon:
DATABASE_URL="postgresql://neondb_owner:password@ep-bold-scene-ac931b17-pooler.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-bold-scene-ac931b17.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH="production"

# 3. Google Gemini AI (Vision)
# Obtenha sua chave gratuitamente no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.5-flash-lite"

# 4. Google Drive API
# Caminho para o arquivo credentials.json da Service Account (no Render pode ser em ./credentials.json ou base64)
GOOGLE_APPLICATION_CREDENTIALS="./credentials.json"
# ID da pasta de fotos das camisas no Google Drive
GOOGLE_DRIVE_FOLDER_ID="13CAQavdPhAAfQBNFxtifhUPgjkIYRtgi"
GOOGLE_DRIVE_SENT_FOLDER_ID=""

# 5. WhatsApp (Baileys)
# Nome exato do grupo onde as ofertas serão postadas
WHATSAPP_GROUP_NAME="CHB - Futebol e Streetwear"
# Opcional: ID direto do grupo (@g.us) caso prefira
WHATSAPP_GROUP_ID=""
# Identificador da sessão no banco de dados
WHATSAPP_SESSION_ID="chb-bot"

# 6. Agendamento Cron
# 5 vezes ao dia (09h, 12h, 15h, 18h, 21h)
CRON_SCHEDULE="0 9,12,15,18,21 * * *"
TIMEZONE="America/Sao_Paulo"
