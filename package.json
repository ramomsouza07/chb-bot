{
  "name": "bot-whatsapp-chb-import",
  "version": "2.0.0",
  "description": "Automação de postagens no WhatsApp para CHB IMPORT integrado com Baileys, Prisma/Neon, Google Drive e Gemini Vision AI para Render",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "test:dry-run": "node src/index.js --dry-run",
    "test:post": "node src/index.js --run-now",
    "check": "node src/checkSetup.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "prisma",
    "neon",
    "render",
    "gemini",
    "google-drive"
  ],
  "author": "CHB IMPORT",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "^6.7.16",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
